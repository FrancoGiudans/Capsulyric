    <string name="wizard_scroll_instruction">觀察句首、句中與句末三個視窗。全部可讀且最後一字出現後，再選「完整顯示」。回答前會循環播放。</string>
    <string name="wizard_expected_ending">預期末尾：%1$s</string>
