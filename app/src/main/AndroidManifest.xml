<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <!-- Query launcher activities of other apps for "Open Playing App" click action -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-sdk tools:overrideLibrary="rikka.shizuku.api, rikka.shizuku.provider, rikka.shizuku.shared, rikka.shizuku.aidl"/>

    <application
        android:name="com.example.islandlyrics.app.IslandLyricsApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IslandLyrics"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:manageSpaceActivity="com.example.islandlyrics.feature.cache.CacheManagementActivity">

        <!-- Main Activity: holds URL scheme filter; launcher filter lives in LauncherAlias -->
        <activity
            android:name="com.example.islandlyrics.feature.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="capsulyric" android:host="settings" />
            </intent-filter>
        </activity>

        <!-- Launcher alias: can be disabled to hide the app icon from the launcher -->
        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity="com.example.islandlyrics.feature.main.MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="com.example.islandlyrics.feature.settings.SettingsActivity"
            android:label="@string/title_app_settings"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:parentActivityName="com.example.islandlyrics.feature.main.MainActivity" />
        <activity
            android:name="com.example.islandlyrics.feature.lastfm.LastFmSettingsActivity"
            android:label="@string/lastfm_title"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:parentActivityName="com.example.islandlyrics.feature.settings.SettingsActivity" />
        <activity
            android:name="com.example.islandlyrics.feature.applemusic.AppleMusicSettingsActivity"
            android:label="@string/apple_music_settings_title"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:parentActivityName="com.example.islandlyrics.feature.settings.SettingsActivity" />
        <activity
            android:name="com.example.islandlyrics.feature.applemusic.AppleMusicLoginActivity"
            android:label="@string/apple_music_web_login_title"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:exported="false"
            android:parentActivityName="com.example.islandlyrics.feature.applemusic.AppleMusicSettingsActivity" />
        <activity
            android:name="com.example.islandlyrics.feature.settings.AboutActivity"
            android:label="@string/about_title"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:parentActivityName="com.example.islandlyrics.feature.settings.SettingsActivity" />
        <activity
            android:name="com.example.islandlyrics.feature.licenses.OpenSourceLicensesActivity"
            android:label="@string/open_source_licenses_title"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:parentActivityName="com.example.islandlyrics.feature.settings.AboutActivity" />
        <activity
            android:name="com.example.islandlyrics.feature.customsettings.CustomSettingsActivity"
            android:label="@string/page_title_personalization"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:parentActivityName="com.example.islandlyrics.feature.main.MainActivity" />
        <activity
            android:name="com.example.islandlyrics.feature.cache.CacheManagementActivity"
            android:label="@string/title_cache_management"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:parentActivityName="com.example.islandlyrics.feature.settings.SettingsActivity" />
        <activity
            android:name="com.example.islandlyrics.feature.faq.FAQActivity"
            android:label="@string/faq_title"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:exported="false" />
        <activity
            android:name="com.example.islandlyrics.feature.parserrule.ParserRuleActivity"
            android:label="@string/title_parser_whitelist_manager"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:parentActivityName="com.example.islandlyrics.feature.main.MainActivity" />
        <activity
            android:name="com.example.islandlyrics.feature.parserrule.ParserRuleEditorActivity"
            android:label="@string/parser_edit"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:parentActivityName="com.example.islandlyrics.feature.parserrule.ParserRuleActivity" />
        <activity
            android:name="com.example.islandlyrics.feature.parserrule.ParserRuleSourceConfigActivity"
            android:label="@string/parser_source_config_title"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:parentActivityName="com.example.islandlyrics.feature.parserrule.ParserRuleEditorActivity" />
        <service
            android:name=".runtime.service.LyricService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="Live rendering of lyrics for third-party media applications"/>
        </service>
        <service 
            android:name=".runtime.service.MediaMonitorService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Quick Settings tile: alternative entry point when launcher icon is hidden -->
        <service
            android:name=".runtime.service.CapsulyricTileService"
            android:label="@string/tile_capsulyric_label"
            android:icon="@drawable/ic_tile_capsulyric"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".runtime.playingapp.NewPlayingAppActionReceiver"
            android:exported="false" />

        <activity android:name="com.example.islandlyrics.feature.diagnostics.DiagnosticsActivity"
                  android:label="@string/title_diagnostics"
                  android:theme="@style/Theme.IslandLyrics.Translucent"
                  android:parentActivityName="com.example.islandlyrics.feature.settings.SettingsActivity" />
        <activity android:name="com.example.islandlyrics.feature.lab.LabActivity"
                  android:label="@string/title_lab"
                  android:theme="@style/Theme.IslandLyrics.Translucent"
                  android:parentActivityName="com.example.islandlyrics.feature.diagnostics.DiagnosticsActivity" />
        <activity android:name="com.example.islandlyrics.feature.onlinelyricdebug.OnlineLyricDebugActivity"
                  android:label="@string/online_lyric_rematch_title"
                  android:theme="@style/Theme.IslandLyrics.Translucent"
                  android:parentActivityName="com.example.islandlyrics.feature.diagnostics.DiagnosticsActivity" />

        <activity
            android:name="com.example.islandlyrics.feature.locallyrics.LocalLyricDirectoryActivity"
            android:label="@string/settings_local_lyrics_directories"
            android:theme="@style/Theme.IslandLyrics.Translucent"
            android:parentActivityName="com.example.islandlyrics.feature.settings.SettingsActivity" />

        <activity android:name="com.example.islandlyrics.feature.logviewer.LogViewerActivity"
                  android:label="Developer Logs"
                  android:theme="@style/Theme.IslandLyrics.Translucent"
                  android:parentActivityName="com.example.islandlyrics.feature.main.MainActivity" />

        <activity android:name="com.example.islandlyrics.feature.mediacontrol.MediaControlActivity"
                  android:theme="@style/Theme.IslandLyrics.Transparent"
                  android:exported="false"
                  android:excludeFromRecents="true"
                  android:taskAffinity=""
                  android:launchMode="singleInstance" />


        <activity
            android:name="com.example.islandlyrics.feature.oobe.OobeActivity"
            android:label="@string/oobe_welcome_title"
            android:theme="@style/Theme.IslandLyrics"
            android:exported="false" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
    </application>

</manifest>
